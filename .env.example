# PostgreSQL connection string. Docker Compose in this repo uses the value below.
DATABASE_URL="postgresql://bgames:bgames@localhost:5434/bgames"

# Auth.js session secret. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Used only by `npm run db:seed`. Never commit a real password.
# The seed creates this account as an administrator, or promotes it if it already exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
